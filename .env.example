# Which data source the admin reads from.
#   mock   - deterministic generators in lib/data/mock.ts (default, no creds needed)
#   stripe - real Stripe account via lib/data/stripe.ts
#   live   - custom backend stub in lib/data/live.ts
ONEORAL_DATA_SOURCE=mock

# ---- Stripe (required when ONEORAL_DATA_SOURCE=stripe) ----

# sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=

# The recurring $49.99/mo membership price id
STRIPE_MEMBERSHIP_PRICE_ID=

# One-time add-on price ids (used to identify add-on line items on invoices)
STRIPE_PRICE_WHITENING=
STRIPE_PRICE_MINTS=
STRIPE_PRICE_MOUTH_SPRAY=

# ---- NetSuite (live fulfillment backend, TBA / OAuth 1.0a) ----
# These names match the storefront app (/Users/ironman/oneoral) so the same
# .env.local can be used in both projects.

NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
# 'true' to use the sandbox account (URL becomes <id>-sb1, realm <id>_SB1)
NETSUITE_SANDBOX=false

# OneOral parent customer in NetSuite
NETSUITE_CUSTOMER_ID=37967247

# Kit item ids
NETSUITE_ITEM_ID_HRK=2910
NETSUITE_ITEM_ID_LRK=2911

# Ship method (Retail Ground)
NETSUITE_SHIP_METHOD_ID=2904

# Dry-test funnel collector (Dry Test tab)
FUNNEL_URL=https://your-funnel.vercel.app
FUNNEL_ADMIN_TOKEN=replace-me
